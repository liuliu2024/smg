{
  "name": "campus-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "start": "node --env-file-if-exists=.env server/dev.mjs --production",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "next build",
    "start:standalone": "node --env-file-if-exists=.env server/main.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env server/db-seed.mjs",
    "demo:reset": "node --env-file-if-exists=.env server/reset-demo.mjs",
    "test:e2e": "playwright test",
    "foundation:configure": "node foundation/configure-demo.mjs",
    "foundation:migrate": "node --env-file-if-exists=.env.foundation foundation/migrate.mjs",
    "foundation:seed": "node --env-file-if-exists=.env.foundation foundation/seed.mjs",
    "foundation:dev": "node --env-file-if-exists=.env.foundation server/dev.mjs",
    "foundation:start:web": "node --env-file-if-exists=.env.foundation server/dev.mjs --production --web-only",
    "foundation:start:worker": "node --env-file-if-exists=.env.foundation foundation/worker.mjs",
    "foundation:reset": "node --env-file-if-exists=.env.foundation foundation/reset.mjs",
    "test:integration": "node --env-file-if-exists=.env.foundation.test foundation/integration-check.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "decimal.js": "10.6.0",
    "lucide-static": "1.68.0",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
